# App ingress
APP_PORT=8000

# Video source
# For Docker Desktop on Windows/macOS, webcam passthrough is usually not available.
# Use SOURCE_TYPE=file with an uploaded/mounted video for cloud/VPS deployments.
SOURCE_TYPE=webcam
CAMERA_DEVICE_ID=0
VIDEO_FILEPATH=

# Stream and inference tuning
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=20
INFERENCE_FPS=2
JPEG_QUALITY=65
MODEL_IMGSZ=416
WEAPON_MODEL_FILE=weapon.pt
FIRE_MODEL_FILE=fire.pt
FALL_MODEL_FILE=fall_model.pt
PERSON_MODEL_FILE=yolo11n.pt
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Object tracking
TRACKING_ENABLED=true
TRACKER_CONFIG=bytetrack.yaml
TRACKING_CONFIDENCE=0.10
TRACKING_HISTORY_SIZE=12
TRACKING_LOST_SECONDS=4.0
LOITERING_SECONDS=20.0
BOUNDARY_CROSSING_THRESHOLD=3
RUNNING_SPEED_PX_S=420.0

# Temporal validation
WEAPON_REQUIRED_FRAMES=5
FIRE_REQUIRED_SECONDS=3.0
FALL_NO_MOVEMENT_SECONDS=5.0
FALL_NO_MOVEMENT_SPEED_PX_S=30.0
FALL_CANDIDATE_LOST_SECONDS=8.0

# Threat scoring engine
ZONE_BASE_RISK=10.0
THREAT_WEIGHT_WEAPON_CONFIDENCE=50.0
THREAT_WEIGHT_INTRUSION_SEVERITY=25.0
THREAT_WEIGHT_MOVEMENT_AGGRESSION=25.0
THREAT_WEIGHT_TIME_SENSITIVITY=12.0
THREAT_WEIGHT_ZONE_RISK=15.0

# Scene memory system
SCENE_MEMORY_ENABLED=true
# Use "memory" for local demos, or "redis" when Redis is available.
SCENE_MEMORY_BACKEND=memory
SCENE_MEMORY_REDIS_URL=redis://localhost:6379/0
SCENE_MEMORY_KEY_PREFIX=rakshak:scene_memory
SCENE_MEMORY_MAX_EVENTS=500
SCENE_MEMORY_TTL_SECONDS=900.0
SCENE_MEMORY_DEDUPE_SECONDS=2.0
SCENE_MEMORY_TIMELINE_LIMIT=25
SCENE_MEMORY_OBJECT_HISTORY=20
SCENE_MEMORY_MIN_SCENE_SCORE=10

# Controlled multi-agent reasoning
MULTI_AGENT_ENABLED=true
MULTI_AGENT_FRAMEWORK=langgraph
MULTI_AGENT_MIN_VERIFICATION_SCORE=0.55
MULTI_AGENT_SUPPRESS_UNVERIFIED=false

# Optional authorized restricted-zone roster
# JSON supports name, role, access_zones, enabled, present, and intrusion_bypass fields.
AUTHORIZED_PEOPLE=[{"name":"Security Guard","role":"Security Staff","access_zones":["CAM_MAIN_ENTRANCE_01"],"enabled":true,"present":false,"intrusion_bypass":false}]

# Optional local vision-language enrichment
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=moondream

# Optional SMTP notifications
SMTP_ENABLED=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_ADDRESS=security-alert@platform.com
TO_ADDRESS=

# Optional Twilio SMS notifications
SMS_ENABLED=false
TO_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
